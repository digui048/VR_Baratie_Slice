--- !u!114 &1250969998
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1250969995}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84242028bcafc3c43bab964a7ed83129, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BaratieBlade.UI.DialoguePresenter
  gameManager: {fileID: 2114246953}
  dialoguePanel: {fileID: 2054447022}
  speakerLabel: {fileID: 2134506920}
  bodyLabel: {fileID: 549791491}
  nextButton: {fileID: 1871866428}
  voiceSource: {fileID: 1782681439}
  speakerName: Zeff
  lines:
  - text: Oi, eggplant! Quit daydreaming, the dinner rush is about to hit.
    voiceClip: {fileID: 8300000, guid: abe3f480f7c2c7d4996d21a0fdbc7f72, type: 3}
  - text: Carne is buried behind the pass. Get in there and give him a hand.
    voiceClip: {fileID: 8300000, guid: f63bd31156042c946ab4cf1e35923185, type: 3}
  - text: He'll toss you everything that needs cutting. Slice it all before it hits
      the floor.
    voiceClip: {fileID: 8300000, guid: 0d36263f814efaf4a972a063d00918e3, type: 3}
  - text: Waste my food and you're scrubbing pots till dawn. Now move!
    voiceClip: {fileID: 8300000, guid: 944c847f62fd0e64084924510f7de4bd, type: 3}
  charactersPerSecond: 40
